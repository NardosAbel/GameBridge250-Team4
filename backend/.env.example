# ==============================================================================
# Campus Esports Ethiopia - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
APP_NAME="Campus Esports Ethiopia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Africa/Addis_Ababa"
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance mode driver
APP_MAINTENANCE_DRIVER=file

# ------------------------------------------------------------------------------
# Logging & Error Tracking
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Database Configuration
# PostgreSQL is the preferred primary production database.
# Schema is fully compatible with MySQL 8.x and SQLite for test suites.
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=campus_esports
DB_USERNAME=campus_user
DB_PASSWORD=secret

# For SQLite local development/testing:
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# ------------------------------------------------------------------------------
# Cache, Session & Queue Configuration
# Redis is required in production for Horizon, rate limiting, and pub/sub.
# ------------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=campus_esports_cache_

QUEUE_CONNECTION=redis

# Redis Connection Details
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ------------------------------------------------------------------------------
# Real-Time WebSockets (Laravel Reverb)
# Powers live tournament brackets, match ready checks, and scanner alerts.
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=campus_esports_app
REVERB_APP_KEY=campus_esports_key
REVERB_APP_SECRET=campus_esports_secret
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ------------------------------------------------------------------------------
# Queue Monitoring (Laravel Horizon)
# ------------------------------------------------------------------------------
HORIZON_PREFIX=campus_esports_horizon:

# ------------------------------------------------------------------------------
# Email / Mailer Testing
# Uses Mailpit in local/staging development.
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@campusesports.et"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Media & Object Storage (S3 / MinIO compatible)
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=campus-esports-media
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

# ------------------------------------------------------------------------------
# API Authentication & Sanctum
# ------------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS="localhost,localhost:8000,127.0.0.1,127.0.0.1:8000"
# Minutes until an API token expires. 10080 = 7 days.
SANCTUM_TOKEN_EXPIRATION=10080

# ------------------------------------------------------------------------------
# Ethiopian Payment Gateways (Provider-Agnostic Abstraction)
# PAYMENTS_SANDBOX=true creates local checkout references and a test HMAC only.
# It does not move money and is not Telebirr/Chapa/M-Pesa live verification.
# Production must keep PAYMENTS_SANDBOX=false. Filling merchant IDs or webhook
# secrets alone will not enable live settlement while sandbox is false.
# Webhook route is /api/v1/payments/webhook/{provider} (singular).
# ------------------------------------------------------------------------------
PAYMENTS_SANDBOX=false

# Telebirr
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_WEBHOOK_SECRET=
TELEBIRR_NOTIFY_URL="${APP_URL}/api/v1/payments/webhook/telebirr"

# Chapa
CHAPA_PUBLIC_KEY=
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_WEBHOOK_URL="${APP_URL}/api/v1/payments/webhook/chapa"

# M-Pesa Ethiopia
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_WEBHOOK_SECRET=

# Card and bank transfer. Leave blank until a live merchant account exists.
CARD_MERCHANT_ID=
CARD_WEBHOOK_SECRET=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_ACCOUNT=
BANK_TRANSFER_WEBHOOK_SECRET=
MANUAL_PAYMENT_DESK=
MANUAL_PAYMENT_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# SMS & Push Notification Gateways
# ------------------------------------------------------------------------------
ETHIO_TELECOM_SMS_API_KEY=
FCM_SERVER_KEY=

# ------------------------------------------------------------------------------
# Frontend Vite Environment
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_APP_ENV="${APP_ENV}"
